meta {
  name: Create Subject
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{v1Path}}/subjects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "subjectCode": "BRU101",
    "subjectName": "Bruno Foundations",
    "credit": 3
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.subjectId) {
    bru.setEnvVar("subjectId", res.body.data.subjectId);
  }
}
