meta {
  name: Create Course For Semester
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}{{v1Path}}/semesters/{{semesterIdForCourse}}/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  semesterIdForCourse: {{semesterIdForCourse}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "courseName": "Bruno Nested Course",
    "subjectId": 1
  }
}

docs {
  # Create Course For Semester
  - Alternate route: `POST /api/semesters/{semesterId}/courses`.
  - `SubjectId` optional here.
}
