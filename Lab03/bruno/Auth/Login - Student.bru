meta {
  name: Login - Student
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "{{userUsername}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.refreshToken);
  }
}

docs {
  # Login (student)
  - Reads `userUsername` / `userPassword` from the **collection vars** in `collection.bru`.
  - Stores `accessToken` / `refreshToken` into the active env on 200.
  - Returns a `User`-role token. Use it to verify 403 on `AdminOnly` endpoints.
}
