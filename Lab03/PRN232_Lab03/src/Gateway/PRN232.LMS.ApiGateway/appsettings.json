{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "LAB03_GATEWAY_SECRET_REPLACE_WITH_ENVIRONMENT_VARIABLE_32_CHARS_MIN",
    "Issuer": "PRN232.LMS",
    "Audience": "PRN232.LMS.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "admin-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/admin/{**remainder}"
        }
      },
      "students-route": {
        "ClusterId": "student-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/students/{**remainder}"
        }
      },
      "students-v2-route": {
        "ClusterId": "student-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/v{version}/students/{**remainder}"
        }
      },
      "courses-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/courses/{**remainder}"
        }
      },
      "enrollments-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/enrollments/{**remainder}"
        }
      },
      "semesters-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/semesters/{**remainder}"
        }
      },
      "subjects-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "ReadOrAdmin",
        "Match": {
          "Path": "/api/subjects/{**remainder}"
        }
      },
      "semester-courses-route": {
        "ClusterId": "course-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/semesters/{semesterId}/courses"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://identity-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Path": "/health"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://student-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Path": "/health"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://course-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Path": "/health"
          }
        }
      }
    }
  }
}
